<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"
    android:background="@color/bg_light">

    <!-- Header below front camera -->
    <TextView
        android:id="@+id/tvQuizHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quiz 1"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/primary_purple"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Question Counter -->
    <TextView
        android:id="@+id/tvQuestionProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question 1/5"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="10dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="5"
        android:progress="1"
        android:progressTint="@color/primary_purple"
        android:layout_marginBottom="24dp" />

    <!-- Question Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@android:color/white"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="Question goes here..."
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- 4 Option Buttons -->
    <Button
        android:id="@+id/btnOption1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="Option 1"
        android:textColor="@color/text_dark"
        android:backgroundTint="@color/option_default_bg"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOption2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="Option 2"
        android:textColor="@color/text_dark"
        android:backgroundTint="@color/option_default_bg"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOption3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="Option 3"
        android:textColor="@color/text_dark"
        android:backgroundTint="@color/option_default_bg"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOption4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="Option 4"
        android:textColor="@color/text_dark"
        android:backgroundTint="@color/option_default_bg"
        android:layout_marginBottom="16dp" />

    <!-- Spacer pushing action button to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Button (NEXT for questions 1 to n-1, SUBMIT for question n) -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="NEXT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_purple" />

</LinearLayout>